{
  "name": "opencode-system-monitor",
  "version": "0.1.0",
  "description": "Linux system monitor for the OpenCode sidebar — CPU, memory, network and NVIDIA GPU.",
  "type": "module",
  "license": "MIT",
  "author": "Sanket Gadge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sanket758/opencode-system-monitor.git"
  },
  "homepage": "https://github.com/Sanket758/opencode-system-monitor#readme",
  "bugs": {
    "url": "https://github.com/Sanket758/opencode-system-monitor/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "system-monitor",
    "cpu",
    "memory",
    "gpu"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/tui.tsx --outdir dist --target node --format esm --packages external --production"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.0",
    "@opentui/solid": ">=0.6.0",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
